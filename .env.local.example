# URL pública da API (usada pelo navegador). O back precisa estar com CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# URL da API vista pelo servidor Next (Server Components e route handlers do BFF).
# Em localhost é a mesma; em Docker seria o nome do serviço (ex.: http://api:3000/api/v1)
API_URL=http://localhost:3000/api/v1

# Caixa de e-mails local (Mailpit do docker-compose do back). Só aparece em links da interface.
NEXT_PUBLIC_MAILPIT_URL=http://localhost:8025

# Mostra as contas de teste do seed na tela de login (só para avaliação local)
NEXT_PUBLIC_CONTAS_TESTE=true
